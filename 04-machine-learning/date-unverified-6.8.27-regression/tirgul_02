import numpy as np
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression

X = np.array([1, 2, 3, 4]).reshape(-1, 1)
y = np.array([8, 10, 8, 5])

poly = PolynomialFeatures(degree=2)

X_poly = poly.fit_transform(X)

print(X_poly)

model = LinearRegression()

model.fit(X_poly, y)

y_pred = model.predict(X_poly)

print("coef:", model.coef_)
print("intercept:", model.intercept_)
print("predictions:", y_pred)

new_x = np.array([[2.5]])

new_x_poly = poly.transform(new_x)

print(new_x_poly)

prediction = model.predict(new_x_poly)

print(prediction)

from sklearn.metrics import mean_squared_error, r2_score

mse = mean_squared_error(y, y_pred)
rmse = np.sqrt(mse)
r2 = r2_score(y, y_pred)

print("MSE:", mse)
print("RMSE:", rmse)
print("R2:", r2)

poly3 = PolynomialFeatures(degree=3)

X_poly3 = poly3.fit_transform(X)

model3 = LinearRegression()
model3.fit(X_poly3, y)

y_pred3 = model3.predict(X_poly3)

print("predictions:", y_pred3)
print("MSE:", mean_squared_error(y, y_pred3))
print("R2:", r2_score(y, y_pred3))